<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="whatsapp_message_form">
            <field name="name">whatsapp.marketing.form</field>
            <field name="model">whatsapp.marketing</field>
            <field name="arch" type="xml">
                <form string="Whatsapp Message">
                    <header>
                        <button name="action_send_message" type="object" invisible="state in ('in_queue', 'done')"
                                class="oe_highlight" string="Send"
                                confirm="This will send the message to all recipients. Do you still want to proceed ?"/>
                        <button name="action_schedule" type="object" invisible="state in ('in_queue', 'done')"
                                class="btn-secondary"
                                string="Schedule"/>
                        <button name="action_cancel" type="object" invisible="state not in ('in_queue')"
                                class="btn-secondary"
                                string="Cancel"/>
                        <button name="action_reset_to_draft" type="object" invisible="state in ('draft', 'in_queue')"
                                class="btn-secondary"
                                string="Reset To Draft"/>
                        <field name="state" readonly="1" widget="statusbar"/>
                    </header>
                    <div class="alert alert-info text-center" role="alert" invisible="state != 'in_queue'">
                        <div invisible="state != 'in_queue'">
                            <strong>
                                <span name="next_departure_text">This message is scheduled for</span>
                                <field name="next_departure" class="oe_inline"/>.
                            </strong>
                        </div>
                    </div>
                    <sheet>
                        <div class="oe_title">
                            <h1>
                                <field name="name" required="1"/>
                            </h1>
                            <h3>
                                <span style="margin-right: 10px;">
                                    <label for="whatsapp_templates_id" string="Templates"/>
                                </span>
                                <field name="whatsapp_templates_id" readonly="state != 'draft'" required="1" id="whatsapp_templates_id"/>
                            </h3>
                        </div>
                        <group>
                            <group>
                                <field name="campaign_list_id" widget="many2one"/>
                            </group>
                            <group>
                                <field name="recipient_ids" widget="many2many" readonly="1"/>
                            </group>
                        </group>
                        <group>
                            <label for="whatsapp_model_id" string="Recipients"/>
                            <div name="whatsapp_model_id_container" >
                                <div class="row">
                                    <div class="col-xs-12 col-md-3">
                                        <field name="whatsapp_model_id" invisible="campaign_list_id != False" readonly="state != 'draft'" widget="selection" id="whatsapp_model_id"/>
                                    </div>
                                </div>
                                <field name="whatsapp_model_name" invisible="1"/>
                                <field name="whatsapp_model_real" invisible="1"/>
                                <field name="whatsapp_domain" readonly="state != 'draft'" widget="domain"
                                       options="{'model': 'whatsapp_model_real'}"
                                />
                            </div>

                        </group>
                        <group>
                            <group>
                                <field name="whatsapp_connection" readonly="state != 'draft'" required="1"/>
                                <field name="whatsapp_provider" invisible="1"/>
                                <field name="user_id" invisible="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page readonly="state != 'draft'" string="Message Body" name="message_body">
                                <div class="alert alert-info">
                                    <strong>Note:</strong>
                                    Your WhatsApp Message uses {{object.field_name}} for dynamic variables.
                                </div>
                                <field name="message_body" readonly="state != 'draft'"
                                       help="Use {{object.field_name}} for dynamic variables."/>
                            </page>

                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="whatsapp_message_tree">
            <field name="name">whatsapp.marketing.list</field>
            <field name="model">whatsapp.marketing</field>
            <field name="arch" type="xml">
                <list string="Whatsapp Message">
                    <field name="whatsapp_templates_id"/>
                    <field name="whatsapp_model_id"/>
                    <field name="user_id"/>
                    <field name="state"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_whatsapp_message">
            <field name="name">Mass Messages</field>
            <field name="view_mode">list,form</field>
            <field name="res_model">whatsapp.marketing</field>
        </record>
    </data>

</odoo>