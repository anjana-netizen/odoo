<odoo>
    <data>
        <record model="ir.ui.view" id="view_whatsapp_campaign_list_tree">
            <field name="name">whatsapp.campaign.list.list</field>
            <field name="model">whatsapp.campaign.list</field>
            <field name="arch" type="xml">
                <list string="Campaign Lists">
                    <field name="name"/>
                    <field name="description"/>
                    <field name="contact_count"/>
                </list>
            </field>
        </record>

        <record model="ir.ui.view" id="view_whatsapp_campaign_list_form">
            <field name="name">whatsapp.campaign.list.form</field>
            <field name="model">whatsapp.campaign.list</field>
            <field name="arch" type="xml">
                <form string="Campaign List">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="description"/>
                            <field name="contact_ids" widget="many2many"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_whatsapp_campaign_list">
            <field name="name">Campaign Lists</field>
            <field name="res_model">whatsapp.campaign.list</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p>Create and manage lists of contacts for targeted WhatsApp marketing campaigns.</p>
            </field>
        </record>
    </data>
</odoo> 