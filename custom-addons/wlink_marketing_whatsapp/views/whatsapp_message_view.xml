<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="view_whatsapp_message_form">
            <field name="name">whatsapp.messages.form</field>
            <field name="model">whatsapp.messages</field>
            <field name="arch" type="xml">
                <form string="Whatsapp Messages" create="0" edit="0">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="sent,received"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="message_body"/>
                                <field name="fromMe"/>
                                <field name="senderName"/>
                                <field name="chatName"/>
                                <field name="time"/>
                                <field name="message_type"/>
                                <field name="wa_template_name"/>
                            </group>
                            <group>
                                <field name="partner_id"/>
                                <field name="message_id"/>
                                <field name="whatsapp_instance_id"/>
                                <field name="whatsapp_message_provider"/>
                                <field name="model"/>
                                <field name="res_id"/>
                            </group>
                        </group>
                        <group string="Attachments">
                            <field name="attachment_data" filename="message_body"
                                   invisible="attachment_data == False"/>
                            <field name="attachment_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="view_whatsapp_messages_tree">
            <field name="name">whatsapp.messages.list</field>
            <field name="model">whatsapp.messages</field>
            <field name="arch" type="xml">
                <list string="Whatsapp Messages" create="0" edit="0">
                    <field name="time" readonly="1" string="Date"/>
                    <field name="senderName" string="From"/>
                    <field name="to"/>
                    <field name="message_type"/>
                    <field name="whatsapp_instance_id"/>
                    <field name="wa_template_id" invisible="1"/>
                    <field name="wa_template_name"/>
                    <field name="message_id"/>
                </list>
            </field>
        </record>

        <record model="ir.actions.act_window" id="action_whatsapp_messages">
            <field name="name">Whatsapp Messages</field>
            <field name="view_mode">list,form</field>
            <field name="res_model">whatsapp.messages</field>
        </record>
    </data>

<!--    <menuitem id="menu_whatsapp_messages" action="action_whatsapp_messages" name="Message History" sequence="30"-->
<!--              parent="whatsapp_menu_main"/>-->

</odoo>

