<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_wlink_contact_wizard_form" model="ir.ui.view">
        <field name="name">wlink.contact.wizard.form</field>
        <field name="model">wlink.contact.wizard</field>
        <field name="arch" type="xml">
            <form string="Send WhatsApp Message">
                <group>
                    <group>
                        <field name="connection"/>
                        <field name="recipients" widget="many2many_tags"/>
                        <field name="mobile_number" invisible="1"/>
                        <field name="message" required="1"/>
                        <field name="mail_template_id" domain="[('model_id', '=', model_id)]"/>
                        <field name="model_id" invisible="1"/>
                        <field name="attachment_ids" widget="many2many_binary" string="Attach a file" nolabel="1"
                               colspan="2"/>
                    </group>
                </group>
                <footer>
                    <button string="Send" type="object" name="send_to_whatsapp" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_wlink_contact_wizard" model="ir.actions.act_window">
        <field name="name">Send Whatsapp Message</field>
        <field name="res_model">wlink.contact.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_wlink_contact_wizard_form"/>
    </record>
</odoo>