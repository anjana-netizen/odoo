<odoo>
    <record id="whatsapp_base_url_editor_form" model="ir.ui.view">
        <field name="name">wlink_whatsapp.base_url_editor.form</field>
        <field name="model">wlink_whatsapp.base_url_editor</field>
        <field name="arch" type="xml">
            <form string="Whatsapp Base URL">
                <group>
                    <field name="base_url"/>
                </group>
                <footer>
                    <button string="Done" class="btn btn-primary" special="cancel"/>
                    <button string="Reset" name="reset" type="object"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="whatsapp_base_url_editor_tree" model="ir.ui.view">
        <field name="name">wlink_whatsapp.base_url_editor.tree</field>
        <field name="model">wlink_whatsapp.base_url_editor</field>
        <field name="arch" type="xml">
            <list string="Whatsapp Base URL">
                <field name="base_url"/>
            </list>
        </field>
    </record>
    <record id="action_whatsapp_base_url_editor" model="ir.actions.act_window">
        <field name="name">Whatsapp Base URL Editor</field>
        <field name="res_model">wlink_whatsapp.base_url_editor</field>
<!--        <field name="target">current</field>-->
        <field name="view_mode">list,form</field>
    </record>
</odoo>